@import url("https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Sora:wght@500;600;700&display=swap");

:root {
  --bg-a: #d0f6f2;
  --bg-b: #e8efff;
  --bg-c: #ffe9cc;
  --card: #ffffff;
  --card-border: #cfd9e7;
  --text: #1a2733;
  --muted: #4d6479;
  --primary: #0f6d8a;
  --primary-hover: #0b5670;
  --ghost-bg: #f4f8fc;
  --ghost-border: #b7c8dc;
  --mono-bg: #102030;
  --mono-text: #d8e7f5;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  color: var(--text);
  font-family: "IBM Plex Sans", "Trebuchet MS", sans-serif;
  background:
    radial-gradient(900px 600px at 10% 90%, var(--bg-a), transparent 60%),
    radial-gradient(900px 700px at 90% 10%, var(--bg-c), transparent 60%),
    linear-gradient(130deg, #e4efff 0%, var(--bg-b) 45%, #f5f9ff 100%);
  min-height: 100vh;
}

.shell {
  max-width: 1080px;
  margin: 0 auto;
  padding: 28px 16px 40px;
}

.page {
  display: none;
  animation: fadeIn 220ms ease;
}

.page--active {
  display: block;
}

.card {
  background: var(--card);
  border: 1px solid var(--card-border);
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 14px;
  box-shadow: 0 10px 24px rgba(42, 71, 105, 0.08);
}

.auth-card {
  max-width: 440px;
  margin: 56px auto 0;
  padding: 24px 20px;
}

h1,
h2,
h3,
h4 {
  margin: 0 0 10px;
  font-family: "Sora", "Segoe UI", sans-serif;
}

h4 {
  margin-top: 12px;
}

.muted {
  color: var(--muted);
  font-size: 14px;
}

form,
.row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 8px;
}

.stack {
  display: grid;
  gap: 8px;
}

.welcome-master-actions {
  margin-top: 4px;
  padding: 10px;
  border: 1px solid var(--card-border);
  border-radius: 10px;
  background: #f8fbff;
}

.welcome-master-actions .muted {
  margin: 0 0 8px;
}

input,
select,
textarea,
button {
  border-radius: 9px;
  border: 1px solid #b7c6d8;
  padding: 9px 11px;
  font: inherit;
}

input,
select,
textarea {
  background: #fcfdff;
  color: var(--text);
}

textarea {
  width: 100%;
  resize: vertical;
  min-height: 76px;
}

label {
  display: grid;
  gap: 4px;
  font-size: 14px;
}

button {
  cursor: pointer;
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
  transition: background 140ms ease, border-color 140ms ease;
}

button:hover {
  background: var(--primary-hover);
  border-color: var(--primary-hover);
}

button.ghost {
  background: var(--ghost-bg);
  color: #27445f;
  border-color: var(--ghost-border);
}

button.ghost:hover {
  background: #e8f0f8;
  border-color: #9db2cb;
}

ul {
  margin: 0;
  padding-left: 20px;
}

pre {
  background: var(--mono-bg);
  color: var(--mono-text);
  border-radius: 9px;
  padding: 12px;
  overflow: auto;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 10px;
}

.chip-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 8px;
}

.master-actions button.is-active {
  background: #0a4f66;
  border-color: #0a4f66;
}

.master-panel {
  display: none;
}

.master-panel--active {
  display: block;
}

.master-panel ul li {
  margin-bottom: 6px;
}

#player-campaign-list button.is-selected,
#master-campaign-list button.is-selected,
#master-active-games-list button.is-selected,
#master-passive-games-list button.is-selected {
  background: #0a4f66;
  border-color: #0a4f66;
}

.quick-filter-row button.is-active {
  background: #d8ebf8;
  border-color: #9fc0db;
  color: #1d3f5a;
}

#master-ruleset-draft-list li {
  display: grid;
  gap: 6px;
  margin-bottom: 8px;
}

#master-ruleset-draft-list span {
  display: block;
}

.draft-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.draft-actions button.is-active {
  background: #d8ebf8;
  border-color: #9fc0db;
  color: #1d3f5a;
}

#master-ruleset-draft-preview {
  max-height: 260px;
}

#player-timeline-output,
#master-timeline-output {
  max-height: 300px;
}

.hidden {
  display: none !important;
}

.sheet-form {
  display: block;
}

.sheet-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 10px;
  margin-bottom: 8px;
}

.sheet-section {
  border: 1px solid var(--card-border);
  border-radius: 12px;
  padding: 10px;
  background: #f8fbff;
  display: grid;
  gap: 8px;
}

.sheet-section legend {
  font-family: "Sora", "Segoe UI", sans-serif;
  font-size: 13px;
  font-weight: 600;
  color: #23445b;
  padding: 0 4px;
}

.sheet-section--wide {
  grid-column: 1 / -1;
}

#master-xp-buy-request-list {
  display: grid;
  gap: 8px;
  padding-left: 0;
  list-style: none;
}

.master-xp-request-item {
  border: 1px solid var(--card-border);
  border-radius: 10px;
  padding: 8px;
  background: #f8fbff;
  display: grid;
  gap: 4px;
}

.master-xp-request-header {
  font-weight: 600;
  color: #23445b;
  font-size: 13px;
}

.triplet-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px;
}

.triplet-cell {
  display: grid;
  gap: 4px;
}

.triplet-mini-label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--muted);
  text-transform: uppercase;
}

.triplet-cell input {
  width: 100%;
}

.triplet-cell input[type="number"] {
  appearance: textfield;
  -moz-appearance: textfield;
}

.triplet-cell input[type="number"]::-webkit-outer-spin-button,
.triplet-cell input[type="number"]::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.triplet-base-wrap {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 4px;
  align-items: stretch;
}

.triplet-base-wrap.quantity {
  display: block;
  position: relative;
  height: 38px;
}

.triplet-base-wrap .triplet-base-input {
  min-width: 0;
  text-align: center;
}

.triplet-base-wrap.quantity .triplet-base-input {
  width: 100%;
  height: 100%;
  padding-right: 28px;
}

.triplet-adjust-btn {
  padding: 0;
  font-weight: 700;
}

.quantity-nav {
  display: grid;
  grid-template-rows: 1fr 1fr;
  gap: 0;
}

.triplet-base-wrap.quantity .quantity-nav {
  position: absolute;
  top: 1px;
  right: 1px;
  bottom: 1px;
  width: 22px;
  border-left: 1px solid #b7c6d8;
  border-radius: 0 6px 6px 0;
  overflow: hidden;
  background: #f4f8fc;
}

.quantity-button {
  min-height: 17px;
  line-height: 1;
  display: grid;
  place-items: center;
  padding: 4px 0;
  font-size: 12px;
}

.quantity-up,
.quantity-down {
  border-radius: 8px;
}

.triplet-base-wrap.quantity .quantity-button {
  border: 0;
  border-radius: 0;
  min-height: 0;
  height: 100%;
  padding: 0;
  background: transparent;
  color: #27445f;
  font-size: 10px;
  line-height: 1;
  font-weight: 600;
}

.triplet-base-wrap.quantity .quantity-button + .quantity-button {
  border-top: 1px solid #b7c6d8;
}

.triplet-base-wrap.quantity .quantity-button:hover {
  background: #e8f0f8;
}

.triplet-base-wrap.quantity .quantity-button:disabled {
  opacity: 0.5;
  cursor: default;
}

.triplet-current-input,
.triplet-bonus-input {
  height: 38px;
  text-align: center;
}

#status {
  margin-top: 8px;
}

@media (max-width: 740px) {
  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .triplet-grid {
    grid-template-columns: 1fr;
  }

  .triplet-base-wrap.quantity .triplet-base-input {
    padding-right: 30px;
  }

  .triplet-base-wrap.quantity {
    height: 40px;
  }

  .triplet-base-wrap.quantity .quantity-nav {
    width: 24px;
  }

  .triplet-current-input,
  .triplet-bonus-input {
    height: 40px;
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
